<resources>
    <color name="canvas">#10161C</color>
    <color name="panel">#19232C</color>
    <color name="border">#374651</color>
    <color name="ink">#F2F7FA</color>
    <color name="muted">#B5C4CD</color>
    <color name="mint">#8BF0BB</color>
    <color name="on_mint">#10251B</color>
    <color name="error">#FFB4AB</color>

    <style name="YoinksTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:statusBarColor">@color/canvas</item>
        <item name="android:navigationBarColor">@color/canvas</item>
        <item name="android:colorAccent">@color/mint</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowSoftInputMode">adjustResize|stateAlwaysHidden</item>
    </style>

    <style name="YoinksLabel">
        <item name="android:textColor">@color/mint</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

    <style name="YoinksButton" parent="android:style/Widget.Material.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:backgroundTint">@color/border</item>
        <item name="android:minHeight">54dp</item>
    </style>
</resources>
